type batterysecret, domain;
type batterysecret_exec, exec_type, vendor_file_type, file_type;

allow batterysecret kmsg_device:chr_file rw_file_perms;
allow batterysecret self:netlink_kobject_uevent_socket { bind create read};
allow batterysecret sysfs:file { open read write };
allow batterysecret vendor_sysfs_qcom_battery:file { getattr open read write };
allow batterysecret vendor_sysfs_qcom_battery:dir r_dir_perms;
allow batterysecret vendor_sysfs_usb_c:dir search;
allow batterysecret vendor_sysfs_usb_supply:dir search;
allow batterysecret vendor_sysfs_usb_supply:file { open read };

init_daemon_domain(batterysecret)

wakelock_use(batterysecret)
