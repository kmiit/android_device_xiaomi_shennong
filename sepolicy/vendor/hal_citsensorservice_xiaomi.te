type vendor_hal_citsensorservice_xiaomi_default, domain, hal_graphics_composer;
type vendor_hal_citsensorservice_xiaomi_default_exec, exec_type, file_type, vendor_file_type;
type vendor_hal_citsensorservice_xiaomi_service, hal_service_type, protected_service, service_manager_type;

allow vendor_hal_citsensorservice_xiaomi_default fwk_sensor_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_default mnt_vendor_file:dir search;
allow vendor_hal_citsensorservice_xiaomi_default self:capability sys_nice;
allow vendor_hal_citsensorservice_xiaomi_default self:qipcrtr_socket { create getattr read setopt write };
# The rule in next line meets neverallow in test build, workarounded
allow vendor_hal_citsensorservice_xiaomi_default vendor_hal_vnddisplayconfig_service:service_manager find;
allow vendor_hal_citsensorservice_xiaomi_default vendor_displayfeature_device:chr_file { ioctl open read };
allow vendor_hal_citsensorservice_xiaomi_default vendor_persist_sensors_file:dir search;
allow vendor_hal_citsensorservice_xiaomi_default vendor_persist_sensors_file:file { getattr open read };
allow vendor_hal_citsensorservice_xiaomi_default vendor_qdisplay_service:service_manager find;
allow vendor_hal_citsensorservice_xiaomi_default vndbinder_device:chr_file { read write };
add_service(vendor_hal_citsensorservice_xiaomi_server, vendor_hal_citsensorservice_xiaomi_service)

hal_client_domain(vendor_hal_citsensorservice_xiaomi_default, hal_graphics_allocator)
hal_server_domain(vendor_hal_citsensorservice_xiaomi_default, vendor_hal_citsensorservice_xiaomi)

binder_call(vendor_hal_citsensorservice_xiaomi_default, hal_graphics_composer)
binder_call(vendor_hal_citsensorservice_xiaomi_default, hwservicemanager)
binder_call(vendor_hal_citsensorservice_xiaomi_default, servicemanager)
binder_call(vendor_hal_citsensorservice_xiaomi_default, system_server)

get_prop(vendor_hal_citsensorservice_xiaomi_default, boot_status_prop)
get_prop(vendor_hal_citsensorservice_xiaomi_default, vendor_qc_aon_prop)
get_prop(vendor_hal_citsensorservice_xiaomi_default, vendor_sensors_prop)
get_prop(vendor_hal_citsensorservice_xiaomi_default, hwservicemanager_prop)
set_prop(vendor_hal_citsensorservice_xiaomi_default, vendor_usedframebuffer_prop)

init_daemon_domain(vendor_hal_citsensorservice_xiaomi_default)

vndbinder_use(vendor_hal_citsensorservice_xiaomi)

r_dir_file(vendor_hal_citsensorservice_xiaomi_default, vendor_sysfs_graphics)
r_dir_file(vendor_hal_citsensorservice_xiaomi_default, vendor_sysfs_displayfeature)
