prebuilt_etc {
    name: "device_vendor_sku_audio_config",
    relative_install_path: "audio/sku_pineapple",
    srcs: [
        "audio/sku_pineapple/adsp_sleep_monitor.conf",
        "audio/sku_pineapple/audio_effects.conf",
        "audio/sku_pineapple/audio_effects.xml",
        "audio/sku_pineapple/audio_policy_configuration.xml",
        "audio/sku_pineapple/mixer_paths_pineapple_mtp.xml",
        "audio/sku_pineapple/resourcemanager_pineapple_mtp.xml",
    ],
    vendor: true,
}

prebuilt_etc {
    name: "device_vendor_audio_config",
    srcs: [
        "audio/audio_policy_configuration.xml",
        "audio/bluetooth_qti_hearing_aid_audio_policy_configuration.xml",
        "audio/microphone_characteristics.xml",
        "audio/usecaseKvManager.xml",
    ],
    vendor: true,
}
